POSTGRES_DB=momento3_powerbi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave_segura
HTTP_PORT=80
POSTGRES_EXPOSE_PORT=5432

# Backups automáticos en AWS S3 (si la EC2 tiene IAM Role, deja las llaves vacías)
AWS_REGION=us-east-2
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=backups/momento3_powerbi
BACKUP_CRON=0 */6 * * *
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
